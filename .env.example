# Copy to .env and fill in. .env is git-ignored; never commit a real token.
#
# SDK token from gadgets.muse.ai (Account > SDK tokens). Every gadget
# needs one to pair. Format: mgst_ followed by 43 characters.
MUSEGADGET_SDK_TOKEN=mgst_REPLACE_ME

# Pin the SDK to a commit SHA for reproducible builds (default: main).
# SDK_REF=main

# Use the prebuilt image from GHCR instead of building locally
# (default: muse-gadget:local, built from the Dockerfile).
# GADGET_IMAGE=ghcr.io/darchons/muse-gadget-docker:latest

# Optional: HTTP CONNECT proxy, the only kind the SDK supports, e.g.
# https_proxy=http://proxy.example:3128
# no_proxy=localhost,host.docker.internal
